APP_NAME="Voss Memory"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://127.0.0.1:8766
LOG_CHANNEL=stderr
DB_CONNECTION=sqlite
# Supply an absolute DB_DATABASE path in the runtime environment.
CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
# Supply VOSS_MEMORY_API_TOKEN in the runtime environment. Blank denies access.
